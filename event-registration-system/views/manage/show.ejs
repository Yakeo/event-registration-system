<%- include('../partials/header') %>

<section class="narrow">
  <a class="back" href="/">← Back to events</a>

  <div class="panel">
    <h1>Manage your registration</h1>
    <p class="muted">
      This page is tied to the link in your confirmation e-mail — no password needed.
      Keep the link private: anyone who has it can change this booking.
    </p>

    <% if (errors && errors.length) { %>
      <div class="alert alert-error">
        <ul style="margin:0;padding-left:18px;">
          <% errors.forEach(function (e) { %><li><%= e %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <table class="kv">
      <tr><th>Reference no.</th><td><strong><%= registration.referenceCode() %></strong></td></tr>
      <tr><th>Participant</th><td><%= participant.full_name %></td></tr>
      <tr><th>Email address</th><td><%= participant.email %></td></tr>
      <tr><th>Event</th><td><%= event ? event.title : '—' %></td></tr>
      <tr><th>Date &amp; time</th><td><%= event ? fmtDate(event.event_date) : '—' %></td></tr>
      <tr><th>Venue</th><td><%= event ? venueName(event) : '—' %></td></tr>
      <tr>
        <th>Status</th>
        <td>
          <span class="badge <%= registration.status === 'confirmed' ? 'badge-success' : registration.status === 'waitlisted' ? 'badge-warn' : 'badge-muted' %>">
            <%= registration.status %>
          </span>
        </td>
      </tr>
      <tr><th>Event capacity</th><td><%= capacity.taken %> / <%= capacity.max %> filled</td></tr>
      <tr><th>Registered on</th><td><%= fmtDate(registration.registration_date) %></td></tr>
    </table>

    <% if (used) { %>
      <div class="alert alert-info">
        <% if (participant && participant.password) { %>
          This link has already been used to set a password for this account.
          <a href="/login">Log in</a> to see all of your registrations in one place.
          You can still view the booking on this page.
        <% } else { %>
          This link has already been used once. You can still view the booking and you can
          still cancel it below; if you need a new link later, use
          <a href="/forgot-password">Forgot Password</a>.
        <% } %>
      </div>
    <% } %>

    <div class="btn-row" style="margin-top:20px;">
      <% if (event) { %>
        <a class="btn btn-outline" href="/events/<%= event.event_id %>">View event page</a>
      <% } %>
      <% if (registration.status !== 'cancelled') { %>
        <form action="/r/<%= token %>/cancel" method="POST" class="inline"
              data-confirm="Cancel this registration? Your slot will be released and offered to the next person on the waiting list.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn-danger" type="submit">Cancel my registration</button>
        </form>
      <% } else { %>
        <p class="muted" style="margin:0;">This registration is already cancelled.</p>
      <% } %>
    </div>
  </div>

  <% if (!participant.password) { %>
    <div class="panel" style="margin-top:24px;">
      <h2>Optional: set a password</h2>
      <p class="muted">
        You can keep using this e-mailed link, or set a password to log in and see
        all of your registrations in one place.
      </p>

      <form action="/r/<%= token %>/claim" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          New password
          <input type="password" name="password" minlength="6" maxlength="72"
                 autocomplete="new-password" required />
        </label>
        <label>
          Confirm new password
          <input type="password" name="confirm_password" minlength="6" maxlength="72"
                 autocomplete="new-password" required />
        </label>
        <button class="btn btn-primary" type="submit">Set password</button>
      </form>
    </div>
  <% } else { %>
    <div class="panel" style="margin-top:24px;">
      <h2>Account</h2>
      <p class="muted">
        This registration is linked to an account that already has a password.
        <a href="/login">Log in</a> to manage all of your registrations, or use
        <a href="/forgot-password">Forgot Password</a> if you need a new one.
      </p>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
