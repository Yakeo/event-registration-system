<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= subject %></title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;-webkit-text-size-adjust:100%;">
  <!-- Table layout + inline styles: every mail client renders this, including
       Outlook and Gmail's web client, which strip <style> blocks. -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f5f7;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background:#ffffff;border-radius:10px;border:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
          <tr>
            <td style="padding:20px 24px;border-bottom:1px solid #eef0f3;">
              <span style="display:inline-block;width:32px;height:32px;line-height:32px;text-align:center;border-radius:8px;background:#1f2937;color:#ffffff;font-weight:700;font-size:13px;vertical-align:middle;">ER</span>
              <span style="font-size:15px;font-weight:700;color:#111827;vertical-align:middle;margin-left:8px;">EventReg</span>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 24px 8px 24px;">
              <h1 style="margin:0 0 12px 0;font-size:20px;line-height:1.3;color:<%= tone === 'success' ? '#15803d' : tone === 'warning' ? '#b45309' : '#111827' %>;">
                <%= heading %>
              </h1>
              <p style="margin:0 0 16px 0;font-size:14px;line-height:1.6;color:#374151;">
                <%= intro %>
              </p>
            </td>
          </tr>

          <% if (rows && rows.length) { %>
          <tr>
            <td style="padding:0 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e5e7eb;border-radius:8px;font-size:13px;">
                <% rows.forEach(function (row, i) { %>
                  <tr style="background:<%= i % 2 === 0 ? '#fbfbfc' : '#ffffff' %>;">
                    <td style="padding:9px 12px;color:#6b7280;width:42%;border-bottom:1px solid #eef0f3;"><%= row[0] %></td>
                    <td style="padding:9px 12px;color:#111827;font-weight:600;border-bottom:1px solid #eef0f3;"><%= row[1] %></td>
                  </tr>
                <% }); %>
              </table>
            </td>
          </tr>
          <% } %>

          <% if (cta) { %>
          <tr>
            <td style="padding:22px 24px 8px 24px;">
              <a href="<%= cta.url %>"
                 style="display:inline-block;background:#1f2937;color:#ffffff;text-decoration:none;font-size:14px;font-weight:600;padding:11px 18px;border-radius:8px;">
                <%= cta.label %>
              </a>
              <% if (secondary) { %>
                <p style="margin:14px 0 0 0;font-size:13px;">
                  <a href="<%= secondary.url %>" style="color:#2440a8;"><%= secondary.label %></a>
                </p>
              <% } %>
              <p style="margin:14px 0 0 0;font-size:12px;color:#9ca3af;word-break:break-all;">
                If the button does not work, copy this link:<br />
                <span style="color:#6b7280;"><%= cta.url %></span>
              </p>
            </td>
          </tr>
          <% } %>

          <% if (footnote) { %>
          <tr>
            <td style="padding:8px 24px 0 24px;">
              <p style="margin:0;font-size:12px;line-height:1.6;color:#6b7280;"><%= footnote %></p>
            </td>
          </tr>
          <% } %>

          <tr>
            <td style="padding:24px;">
              <p style="margin:0;font-size:11px;line-height:1.6;color:#9ca3af;border-top:1px solid #eef0f3;padding-top:16px;">
                This message was sent automatically by the Event Registration System.
                Please do not reply to this address.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
