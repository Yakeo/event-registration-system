<%- include('../partials/header') %>

<section class="narrow">
  <div class="panel">
    <h1>Forgot password</h1>
    <p class="muted">Enter your registered email address and we will generate a secure password reset link.</p>
    <%- include('../partials/errors') %>

    <% if (typeof submitted !== 'undefined' && submitted && !resetLink) { %>
      <div class="alert alert-success" style="margin-bottom: 20px;">
        <strong>Request received.</strong>
        <p style="margin:6px 0 0 0; font-size:0.9rem;">
          If an account with that email address exists, a password reset link has been
          generated and sent to its inbox. The link is valid for one hour.
        </p>
      </div>
    <% } %>

    <% if (resetLink) { %>
      <div class="alert alert-success" style="margin-bottom: 20px;">
        <h3 style="margin-top:0; font-size:1.1rem; color:var(--success);">✔ Reset Link Generated!</h3>
        <p style="margin-bottom: 8px;">
          Password reset token created for <strong><%= targetUser.full_name %></strong> (<code><%= targetUser.email %></code>).
        </p>
        <div class="defense-callout">
          <strong>🎓 Academic Defense / Demo Feature:</strong>
          <p style="margin: 6px 0 10px 0; font-size: 0.9rem;">
            In a production environment, an email is dispatched to the user's inbox. For defense demonstration purposes, you can test the reset workflow immediately:
          </p>
          <a class="btn btn-primary btn-block" href="<%= resetLink %>">Proceed to Reset Password →</a>
          <p style="margin-top: 8px; font-size: 0.8rem; word-break: break-all; color: var(--muted);">
            Link: <code><%= resetLink %></code> (Valid for 1 hour)
          </p>
        </div>
      </div>
    <% } %>

    <form method="POST" action="/forgot-password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label>Registered email address
        <input type="email" name="email" value="<%= old.email || '' %>" placeholder="juan@email.com" required />
      </label>
      <button class="btn btn-primary btn-block" style="margin-top: 14px;" type="submit">Generate Reset Link</button>
    </form>

    <div class="auth-footer-links">
      <p class="hint center"><a href="/login">← Return to Log in</a></p>
      <div class="demo-box">
        <strong>Demo tip:</strong>
        <p style="margin:4px 0 0 0; font-size:0.85rem;">
          Try resetting the password for <code>maria@email.com</code> or <code>admin@eventreg.test</code>.
        </p>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
