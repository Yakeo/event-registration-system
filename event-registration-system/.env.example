# ---------------------------------------------------------------------------
# Event Registration System — environment template
# Copy to .env (cp .env.example .env) and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# ---- HTTP -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- Security -------------------------------------------------------------
# REQUIRED when NODE_ENV=production: the server refuses to boot without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database -------------------------------------------------------------
# sqlite (default, zero setup) | mysql | postgres
DB_DIALECT=sqlite

# SQLite only — where the .sqlite file lives.
# ':memory:' gives a throw-away database (used by `npm test`).
DB_STORAGE=./database/event_registration.sqlite

# MySQL / PostgreSQL only
DB_NAME=event_registration
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TIMEZONE=+08:00

# Print every SQL statement Sequelize runs (very noisy)
DB_LOGGING=false

# ---- Notifications ---------------------------------------------------------
# Absolute base URL used in e-mail links (reset, claim, event pages).
APP_URL=http://localhost:3000

# console (default) -> writes .eml files to tmp/outbox/, no SMTP needed
# smtp              -> delivers through nodemailer using the SMTP_* values below
# memory            -> records messages in memory (used by `npm test`)
MAIL_TRANSPORT=console
MAIL_FROM="EventReg <no-reply@eventreg.test>"

# How often the outbox worker drains, in milliseconds (0 = only on demand)
MAIL_INTERVAL_MS=15000
# Set to "off" to keep rows queued and deliver nothing (useful for demos/tests)
# MAIL_WORKER=off

# SMTP_* is only read when MAIL_TRANSPORT=smtp
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ---- Guest reference codes -------------------------------------------------
# Used to sign REG-xxxxx-yyyyyy codes. Falls back to SESSION_SECRET.
# REFERENCE_SECRET=change-me-too
